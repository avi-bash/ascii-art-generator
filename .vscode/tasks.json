{
    "tasks": [
        {
            "type": "shell",
            "label": "Build with MSVC",
            "command": "C:/Program Files (x86)/Microsoft Visual Studio/18/BuildTools/VC/Tools/MSVC/14.51.36231/bin/HostX64/x64/cl.exe",
            "args": [
                "/nologo",
                "/std:c++17",
                "/EHsc",
                "/I${workspaceFolder}/opencv/build/include",
                "${workspaceFolder}/ascii-translation.cpp",
                "/Fe:${workspaceFolder}/build/Debug/ascii-translation.exe",
                "/link",
                "/LIBPATH:${workspaceFolder}/opencv/build/x64/vc16/lib",
                "opencv_world500.lib"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build with MSVC and local OpenCV"
        }
    ],
    "version": "2.0.0"
}